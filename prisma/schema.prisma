generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  budgets  Budget[]
}

model Account {
  id                String   @id @default(cuid())
  plaidAccountId    String   @unique
  plaidItemId       String
  plaidAccessToken  String
  institutionName   String
  accountName       String
  accountType       String
  balance           Decimal  @db.Decimal(12,2)

  userId String
  user   User @relation(fields: [userId], references: [id])

  transactions Transaction[]

  @@index([plaidItemId])
}

model Transaction {
  id           String   @id @default(cuid())
  plaidTxnId   String   @unique
  merchantName String?
  category     String?
  amount       Decimal  @db.Decimal(12,2)
  date         DateTime
  pending      Boolean

  accountId String
  account   Account @relation(fields: [accountId], references: [id])
}

model Budget {
  id       String   @id @default(cuid())
  category String
  limit    Decimal  @db.Decimal(12,2)
  month    String

  userId String
  user   User @relation(fields: [userId], references: [id])
}